    {
      "parameters": {
        "jsCode": "// 1. Obtenemos el texto en bruto que nos ha devuelto Gemini\nlet textoGemini = $input.first().json.content.parts[0].text;\n\n// 2. Limpiamos cualquier formato markdown residual (los famosos ```json)\ntextoGemini = textoGemini.replace(/```json/gi, \"\").replace(/```/gi, \"\").trim();\n\n// 3. Nos aseguramos de empezar exactamente en la primera llave\nlet inicio = textoGemini.indexOf('{');\ntextoGemini = textoGemini.substring(inicio);\n\nlet datosParseados;\n\n// 4. Bucle de rescate: intenta parsear, si hay caracteres basura al final, corta a la llave anterior y reintenta\ntry {\n    // Intentamos procesar el JSON normalmente\n    datosParseados = JSON.parse(textoGemini);\n} catch (error) {\n    // Si falla por la llave extra, buscamos la penúltima '}'\n    let fin = textoGemini.lastIndexOf('}', textoGemini.lastIndexOf('}') - 1);\n    textoGemini = textoGemini.substring(0, fin + 1);\n    \n    // Volvemos a parsear con el texto limpio\n    datosParseados = JSON.parse(textoGemini);\n}\n\n// 5. Devolvemos las dos variables totalmente limpias y separadas en formato Array de n8n\nreturn [{\n    json: {\n        cv_html: datosParseados.cv_html,\n        email_body: datosParseados.email_body\n    }\n}];"
      },
