      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nif (!Array.isArray(item.titulo)) {\n    return []; \n}\n\n// LÍMITE ESTRICTO: Procesar solo las primeras 19 ofertas para proteger la cuota\nconst numOfertas = Math.min(item.titulo.length, 19);\nconst resultados = [];\n\nfor (let i = 0; i < numOfertas; i++) {\n    resultados.push({\n        json: {\n            titulo: item.titulo[i] || \"\",\n            enlace: item.enlace[i] || \"\"\n        }\n    });\n}\n\nreturn resultados;"
